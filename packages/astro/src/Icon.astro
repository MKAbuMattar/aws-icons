---
import type {IconCategory, IconSlug} from '@aws-icons/svg';
import {loadIconSvg} from './load.js';

interface Props {
  /** Icon slug, e.g. "amazon-ec2" */
  name: IconSlug;
  /** Icon set — "architecture-service" (default), "architecture-group", "category", "resource", or "resource-dark" */
  variant?: IconCategory;
  /** Accessible label; without it the icon is aria-hidden (decorative) */
  title?: string;
  [attr: string]: unknown;
}

const {name, variant = 'architecture-service', title, ...attrs} = Astro.props;

const svg = await loadIconSvg(name, variant, {
  role: 'img',
  ...(title ? {'aria-label': title} : {'aria-hidden': 'true'}),
  ...attrs,
});
---

<Fragment set:html={svg} />
