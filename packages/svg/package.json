{
  "name": "@aws-icons/svg",
  "version": "4.0.0",
  "description": "AWS Architecture Icons as optimized SVGs (flat, high-contrast, modern) with typed metadata. Successor of the aws-icon package.",
  "keywords": [
    "aws",
    "icon",
    "aws-icon",
    "icons",
    "svg"
  ],
  "license": "MIT",
  "author": {
    "name": "Mohammad Abu Mattar",
    "email": "mohammad.khaled@outlook.com",
    "url": "https://mkabumattar.github.io/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MKAbuMattar/aws-icons.git",
    "directory": "packages/svg"
  },
  "bugs": {
    "url": "https://github.com/MKAbuMattar/aws-icons/issues"
  },
  "homepage": "https://aws-icons.mkabumattar.com/",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./metadata.json": "./metadata.json",
    "./icons/*": "./icons/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "icons",
    "metadata.json"
  ],
  "scripts": {
    "build": "tsx build.ts && tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "tsx test/smoke.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
