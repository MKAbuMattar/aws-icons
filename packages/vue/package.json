{
  "name": "@aws-icons/vue",
  "version": "3.3.0",
  "description": "AWS Architecture Icons as tree-shakeable typed Vue 3 components (flat, high-contrast, modern).",
  "keywords": [
    "aws",
    "icon",
    "aws-icon",
    "icons",
    "svg",
    "vue"
  ],
  "license": "MIT",
  "author": {
    "name": "Mohammad Abu Mattar",
    "email": "mohammad.khaled@outlook.com",
    "url": "https://mkabumattar.github.io/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MKAbuMattar/aws-icons.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/MKAbuMattar/aws-icons/issues"
  },
  "homepage": "https://aws-icons.mkabumattar.com/",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/core.cjs",
  "module": "./dist/core.js",
  "types": "./dist/core.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./architecture-group": {
      "import": {
        "types": "./dist/architecture-group/index.d.ts",
        "default": "./dist/architecture-group/index.js"
      },
      "require": {
        "types": "./dist/architecture-group/index.d.cts",
        "default": "./dist/architecture-group/index.cjs"
      }
    },
    "./architecture-group/*": {
      "import": {
        "types": "./dist/architecture-group/icons/*.d.ts",
        "default": "./dist/architecture-group/icons/*.js"
      },
      "require": {
        "types": "./dist/architecture-group/icons/*.d.cts",
        "default": "./dist/architecture-group/icons/*.cjs"
      }
    },
    "./architecture-service": {
      "import": {
        "types": "./dist/architecture-service/index.d.ts",
        "default": "./dist/architecture-service/index.js"
      },
      "require": {
        "types": "./dist/architecture-service/index.d.cts",
        "default": "./dist/architecture-service/index.cjs"
      }
    },
    "./architecture-service/*": {
      "import": {
        "types": "./dist/architecture-service/icons/*.d.ts",
        "default": "./dist/architecture-service/icons/*.js"
      },
      "require": {
        "types": "./dist/architecture-service/icons/*.d.cts",
        "default": "./dist/architecture-service/icons/*.cjs"
      }
    },
    "./category": {
      "import": {
        "types": "./dist/category/index.d.ts",
        "default": "./dist/category/index.js"
      },
      "require": {
        "types": "./dist/category/index.d.cts",
        "default": "./dist/category/index.cjs"
      }
    },
    "./category/*": {
      "import": {
        "types": "./dist/category/icons/*.d.ts",
        "default": "./dist/category/icons/*.js"
      },
      "require": {
        "types": "./dist/category/icons/*.d.cts",
        "default": "./dist/category/icons/*.cjs"
      }
    },
    "./resource": {
      "import": {
        "types": "./dist/resource/index.d.ts",
        "default": "./dist/resource/index.js"
      },
      "require": {
        "types": "./dist/resource/index.d.cts",
        "default": "./dist/resource/index.cjs"
      }
    },
    "./resource/*": {
      "import": {
        "types": "./dist/resource/icons/*.d.ts",
        "default": "./dist/resource/icons/*.js"
      },
      "require": {
        "types": "./dist/resource/icons/*.d.cts",
        "default": "./dist/resource/icons/*.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/core.ts --format esm,cjs --dts --out-dir dist --clean --external vue && tsx build.ts",
    "test": "tsx test/smoke.ts"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@vue/server-renderer": "^3.5.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vue": "^3.5.0"
  }
}
